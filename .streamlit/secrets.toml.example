# Copy to secrets.toml locally. That filename is ignored by Git.
# Use the WEB client ID here, never the API client ID.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_SECRET"
client_id = "REPLACE_WITH_WEB_CLIENT_ID"
client_secret = "REPLACE_WITH_WEB_CLIENT_SECRET_VALUE"
server_metadata_url = "https://login.microsoftonline.com/REPLACE_WITH_TENANT_ID/v2.0/.well-known/openid-configuration"
expose_tokens = ["access"]

[auth.client_kwargs]
scope = "openid profile email api://REPLACE_WITH_API_CLIENT_ID/access_as_user"
